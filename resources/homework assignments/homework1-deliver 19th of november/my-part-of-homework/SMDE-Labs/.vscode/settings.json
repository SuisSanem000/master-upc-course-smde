{
    // Hide the files of the UPC LaTeX template that the report
    // (report/ociamthesismain.tex) does not use
    "files.exclude": {
        "report/Beamer": true,
        "report/Cover": true,
        "report/Figure": true,
        "report/Table": true,
        "report/cornell.cls": true,
        "report/hangcaption.sty": true,
        "report/ltxdoc.cfg": true,
        "report/*.mf": true,
        "report/oxlogo.png": true,
        "report/upclogo.pdf": true,
        "report/upc-logo-black.pdf": true,
        "report/ociamthesismain.pdf": true
    },

    // LaTeX Workshop: build into report/_build (git-ignored)
    "latex-workshop.latex.outDir": "%DIR%/_build",

    // LTeX+ (grammar and spell checker of the LaTeX report and the Markdown files)
    // American English, as in the statements of the assignment
    "ltex.language": "en-US",
    "ltex.enabled": ["latex", "markdown"],

    // How LTeX reads our LaTeX macros
    "ltex.latex.commands": {
        "\\texttt{}": "dummy",              // R variable names: read as one word, not spell-checked
        "\\autoref{}": "dummy",             // "Table 2", "Figure 1"
        "\\csvtable{}{}{}": "ignore",       // tables from the R scripts
        "\\csvtable[]{}{}{}": "ignore",
        "\\titlelogo{}": "ignore",          // title page fields with images or Catalan names
        "\\titleseal{}": "ignore",
        "\\faculty{}": "ignore",
        "\\university{}": "ignore"
    },

    // Words of the project that are not in the English dictionary
    "ltex.dictionary": {
        "en-US": [
            "SMDE", "MIRI", "UPC", "FIB", "BarcelonaTech", "Modelling", "Visualisation",
            "boxplot", "boxplots", "interquartile", "bimodal", "hypotension",
            "Shapiro", "Wilk", "Kaggle", "Typst", "Rscript", "datatool"
        ]
    },

    // Words added and rules disabled with the quick fixes are saved here (shared in the repo)
    "ltex.configurationTarget": {
        "dictionary": "workspace",
        "disabledRules": "workspace",
        "hiddenFalsePositives": "workspace"
    },
    "r.lsp.promptToInstall": false
}
